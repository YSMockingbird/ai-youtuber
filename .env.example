YOUTUBE_API_KEY=your_youtube_api_key
OPENAI_API_KEY=your_openai_api_key
# 空欄の場合はOAuthで現在ライブ中の自分の配信を自動取得します。
YOUTUBE_VIDEO_ID=
YOUTUBE_OAUTH_CLIENT_FILE=.secrets/youtube_oauth_client.json
YOUTUBE_OAUTH_TOKEN_FILE=.secrets/youtube_oauth_token.json
# 再利用可能な配信ストリームが複数ある場合に、使用するIDを指定します。
YOUTUBE_STREAM_ID=
OPENAI_MODEL=gpt-5.6-luna
# LLMへ渡す現在日時のタイムゾーンです。
AITUBER_TIMEZONE=Asia/Tokyo
# Geminiを使う場合に設定します。
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
LLM_PROVIDER=openai
MEMORY_DB_PATH=data/memory.db
CHARACTER_MEMORY_DB_PATH=data/character_memory.db
BROADCAST_SCHEDULE_DB_PATH=data/broadcast_schedule.db
# 常駐管理サービスがカレンダーを確認し、事前にアプリを準備して予定時刻に配信を開始します。
AUTO_SCHEDULE_ENABLED=true
AUTO_SCHEDULE_CHECK_INTERVAL_SECONDS=15
# 告知用のYouTube待機枠を配信開始の48時間前に作成します。
YOUTUBE_FRAME_CREATE_HOURS_BEFORE=48
YOUTUBE_FRAME_CREATE_RETRY_MINUTES=15
# AI配信構成とAivisSpeech・AITuber OnAir・OBSを準備する時間です。
AUTO_SCHEDULE_PREPARE_MINUTES_BEFORE=10
AUTO_SCHEDULE_LATE_GRACE_MINUTES=15
AIVIS_API_URL=http://127.0.0.1:10101
AIVIS_SPEAKER_ID=ここにAivisSpeechのスタイルID
AIVIS_TIMEOUT_SECONDS=180
# ai-youtuber-live開始時にAivisSpeechアプリを自動起動します。
AUTO_START_AIVIS=true
AIVIS_APP_PATH=/Applications/AivisSpeech.app
# OBSのブラウザソース用にAITuber OnAirを自動起動します。通常ブラウザは開きません。
AUTO_START_AITUBER=true
AITUBER_DIRECTORY=~/my-aituber
AITUBER_ONAIR_URL=http://localhost:5173/?mode=broadcast
# AivisSpeechとAITuber OnAirの起動完了を待つ最大秒数です。
LOCAL_SERVICE_START_TIMEOUT_SECONDS=120
CONTROL_SERVER_PORT=8765
# OBS字幕・話題カード・コメントが接続するまで開始挨拶を待つ秒数。0で待機を無効化します。
OBS_OVERLAY_WAIT_SECONDS=120
# ai-youtuber-live開始時にOBSアプリを自動起動します。
AUTO_START_OBS=true
OBS_APP_PATH=/Applications/OBS.app
# OBS 28以降の内蔵WebSocketを使って配信出力を自動停止します。
OBS_WEBSOCKET_ENABLED=false
OBS_WEBSOCKET_HOST=127.0.0.1
OBS_WEBSOCKET_PORT=4455
OBS_WEBSOCKET_PASSWORD=ここにOBSのWebSocketパスワード
OBS_WEBSOCKET_TIMEOUT_SECONDS=5
# YouTubeライブの再検索間隔。タイムアウトは0で無制限待機です。
YOUTUBE_LIVE_WAIT_INTERVAL_SECONDS=10
YOUTUBE_LIVE_WAIT_TIMEOUT_SECONDS=0
# 空欄ならVTuber・アニメ・ゲーム・ネット話題の既定フィードを使用します。
NEWS_RSS_URLS=
NEWS_TIMEOUT_SECONDS=10
NEWS_MAX_AGE_HOURS=168
NEWS_CACHE_SECONDS=600
NEWS_HISTORY_DB_PATH=data/news_history.db
NEWS_HISTORY_DAYS=14
MOTION_COOLDOWN_SECONDS=12
MOCK_LIVE_DELAY_SECONDS=15
